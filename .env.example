# NepalPay Wallet - Production Environment Template
# ==================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control!

# ─── APPLICATION ───
APP_NAME=NepalPay
APP_URL=https://nepalpay.com
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kathmandu
APP_KEY=change-me-to-32-char-random-string

# ─── DATABASE ───
DB_HOST=localhost
DB_NAME=wallet
DB_USER=wallet_user
DB_PASSWORD=change-me-to-strong-password
DB_CHARSET=utf8mb4

# ─── SECURITY ───
# Secrets encryption key (generate: openssl rand -hex 32)
SECRETS_ENCRYPTION_KEY=

# Transaction PIN settings
TRANSACTION_PIN_REQUIRED=true
TRANSACTION_PIN_MAX_ATTEMPTS=3
TRANSACTION_PIN_LOCKOUT_MINUTES=30

# Rate limits
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_API=100
RATE_LIMIT_API_WINDOW=60

# Transaction limits (NPR)
TRANSACTION_SINGLE_LIMIT=25000
TRANSACTION_DAILY_LIMIT=50000
TRANSACTION_MONTHLY_LIMIT=500000

# ─── ALERTS & NOTIFICATIONS ───
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_RECIPIENTS=security@nepalpay.com,admin@nepalpay.com
ALERT_EMAIL_FROM=NepalPay Security <security@nepalpay.com>

ALERT_SMS_ENABLED=false
ALERT_SMS_GATEWAY=generic
ALERT_SMS_NUMBERS=+97798XXXXXXXX

ALERT_WEBHOOK_URL=https://incident.nepalpay.com/webhook

# ─── SMS GATEWAY (configure if ALERT_SMS_ENABLED=true) ───
SMS_API_KEY=
SMS_API_SECRET=
SMS_GENERIC_URL=https://api.smsgateway.com/send

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=

# ─── BACKUP ───
BACKUP_PATH=/var/backups/nepalpay
BACKUP_S3_ENABLED=false
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=nepalpay-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# ─── MAIL (for user notifications) ───
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@nepalpay.com
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM=noreply@nepalpay.com

# ─── RECAPTCHA ───
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── MONITORING ───
SENTRY_DSN=
LOG_LEVEL=warning
