# NepalPay Configuration
# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wallet
DB_USER=root
DB_PASS=

# Application
APP_NAME=NepalPay
APP_URL=http://localhost/wallet
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu

# Security
SESSION_LIFETIME=3600
SESSION_NAME=NEPALPAY_SESSION
CSRF_TOKEN_NAME=csrf_token
OTP_EXPIRY=300
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800

# QR Code
QR_PREFIX=NP
QR_CODE_PATH=/public/img/qr/

# Pagination
ITEMS_PER_PAGE=20

# Notification
ENABLE_NOTIFICATIONS=true