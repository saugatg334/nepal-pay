{
    "name": "nepalpay/wallet",
    "description": "NepalPay Digital Wallet System - Production Grade",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.0",
        "monolog/monolog": "^2.0",
        "phpmailer/phpmailer": "^6.8",
        "twilio/sdk": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
  "autoload": {
    "psr-4": {
      "NepalPay\\": "app/"
    },
    "classmap": [
      "app/controller/",
      "app/models/",
      "app/helpers/",
      "app/config/"
    ],
    "files": [
      "app/helpers/helpers.php",
      "app/helpers/lang.php"
    ]
  },
    "scripts": {
        "test": "phpunit",
        "start": "php -S localhost:8000 public/index.php",
        "post-install-cmd": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
