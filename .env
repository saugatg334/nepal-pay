# NepalPay Wallet - Environment Configuration
APP_NAME=NepalPay
APP_URL=http://localhost/wallet
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wallet
DB_USER=root
DB_PASS=

# Session
SESSION_NAME=NEPALPAY_SESSION
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_API=100
RATE_LIMIT_API_WINDOW=60

# OTP
OTP_EXPIRY=300

# Logging
LOG_LEVEL=debug
LOG_MAX_FILES=30

